# Path to your deck data folder (the one containing decks/, card_types/, templates/)
BANK_PATH=/abs/path/to/your-bank

OPENAI_API_KEY=sk-...

# Gemini keys — add as many as you have, numbered from 1
# When one key hits quota the pipeline rotates to the next automatically
GEMINI_API_KEY_1=AIza...
GEMINI_API_KEY_2=AIza...
GEMINI_API_KEY_3=AIza...
